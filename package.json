{
  "name": "pw_projects",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test_demo": "cross-env ENV_NAME=demo npx playwright test",
    "test_dev": "cross-env ENV_NAME=dev npx playwright test",
    "setup_demo": "cross-env ENV_NAME=demo npx playwright test --project=setup",
    "setup_dev": "cross-env ENV_NAME=dev npx playwright test --project=setup",
    "test_demo_cr_hd": "cross-env ENV_NAME=demo npx playwright test --project=chromium --headed",
    "test_demo_fr_hd": "cross-env ENV_NAME=demo npx playwright test --project=firefox --headed",
    "test_demo_cr_hl": "cross-env ENV_NAME=demo npx playwright test --project=chromium",
    "test_demo_fr_hl": "cross-env ENV_NAME=demo npx playwright test --project=firefox",
    "test_perf": "k6 run tests/performance/demo.perf.ts",
    "perf:load": "k6 run tests/performance/load-test.perf.ts",
    "perf:stress": "k6 run tests/performance/stress-test.perf.ts",
    "perf:endurance": "k6 run tests/performance/endurance-test.perf.ts",
    "perf:spike": "k6 run tests/performance/spike-test.perf.ts",
    "perf:scalability": "k6 run tests/performance/scalability-test.perf.ts",
    "perf:volume": "k6 run tests/performance/volume-test.perf.ts",
    "cwv:login":       "k6 run --out json=performance-results/cwv-login.json       tests/performance/cwv/cwv-login.perf.ts",
    "cwv:dashboard":   "k6 run --out json=performance-results/cwv-dashboard.json   tests/performance/cwv/cwv-dashboard.perf.ts",
    "cwv:admin":       "k6 run --out json=performance-results/cwv-admin.json       tests/performance/cwv/cwv-admin.perf.ts",
    "cwv:pim":         "k6 run --out json=performance-results/cwv-pim.json         tests/performance/cwv/cwv-pim.perf.ts",
    "cwv:leave":       "k6 run --out json=performance-results/cwv-leave.json       tests/performance/cwv/cwv-leave.perf.ts",
    "cwv:time":        "k6 run --out json=performance-results/cwv-time.json        tests/performance/cwv/cwv-time.perf.ts",
    "cwv:recruitment": "k6 run --out json=performance-results/cwv-recruitment.json tests/performance/cwv/cwv-recruitment.perf.ts",
    "cwv:myinfo":      "k6 run --out json=performance-results/cwv-myinfo.json      tests/performance/cwv/cwv-myinfo.perf.ts",
    "cwv:performance": "k6 run --out json=performance-results/cwv-performance.json tests/performance/cwv/cwv-performance.perf.ts",
    "cwv:directory":   "k6 run --out json=performance-results/cwv-directory.json   tests/performance/cwv/cwv-directory.perf.ts",
    "cwv:maintenance": "k6 run --out json=performance-results/cwv-maintenance.json tests/performance/cwv/cwv-maintenance.perf.ts",
    "cwv:buzz":        "k6 run --out json=performance-results/cwv-buzz.json        tests/performance/cwv/cwv-buzz.perf.ts",
    "test_perf_ui": "cross-env K6_BROWSER_ENABLED=true k6 run tests/performance/demo-browser.perf.ts",
    "mcp-server": "npx playwright-mcp",
    "allure:generate": "npx allure generate ./allure-results --clean",
    "allure:open": "npx allure open ./allure-report",
    "allure:serve": "npx allure serve ./allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/crypto-js": "^4.2.2",
    "@types/k6": "^1.7.0",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "xlsx": "^0.18.5"
  }
}
